<mxfile host="drawio"><diagram id="fleet-data-flow" name="fleet-data-flow"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" page="1" pageWidth="1180" pageHeight="640" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ag" value='&lt;b&gt;spired check-in&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;reports from the device&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="170" height="60" as="geometry"/></mxCell><mxCell id="inv" value='&lt;b&gt;Inventory&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;hardware, network, software, security; at most every 6 h&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="280" y="120" width="200" height="70" as="geometry"/></mxCell><mxCell id="sen" value='&lt;b&gt;Sensors&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;accepted only for sensors sent to this device&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="280" y="250" width="200" height="60" as="geometry"/></mxCell><mxCell id="cve" value='&lt;b&gt;CVE matching&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Debian security feed vs installed source packages&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="280" y="370" width="200" height="70" as="geometry"/></mxCell><mxCell id="attr" value='&lt;b&gt;Device attributes&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;typed values; each writer owns its keys&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=12;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="550" y="160" width="190" height="110" as="geometry"/></mxCell><mxCell id="grp" value='&lt;b&gt;Dynamic groups&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;rules compiled to parameterised SQL; recomputed at check-in and every 5 min&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="810" y="200" width="330" height="70" as="geometry"/></mxCell><mxCell id="pol" value='&lt;b&gt;Policies and applications&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;target tags, rings and groups&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="810" y="330" width="200" height="60" as="geometry"/></mxCell><mxCell id="camp" value='&lt;b&gt;Patch campaigns&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;target a group, CVE list or packages&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="810" y="420" width="200" height="60" as="geometry"/></mxCell><mxCell id="ev" value='&lt;b&gt;Event log&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;enrolled, inventory changed, CVE matched, offline, attestation failed, ...&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="280" y="510" width="260" height="70" as="geometry"/></mxCell><mxCell id="wf" value='&lt;b&gt;Workflow engine&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;trigger, condition (group rule language), actions; each event processed once&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="600" y="510" width="260" height="70" as="geometry"/></mxCell><mxCell id="act" value='&lt;b&gt;Actions&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;tags, ring, group include, run script, alert, lock, quarantine, approval, start_campaign&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="920" y="500" width="220" height="90" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;" edge="1" parent="1" source="ag" target="inv"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="125" y="155"/></Array></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ag" target="sen"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;" edge="1" parent="1" source="ag" target="cve"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="125" y="405"/></Array></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="inv" target="attr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;font