<mxfile host="drawio"><diagram id="signed-updates" name="signed-updates"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" page="1" pageWidth="1180" pageHeight="760" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="off" value="Offline (release engineering)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;container=1;collapsible=0;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="300" height="260" as="geometry"/></mxCell><mxCell id="kg" value='&lt;b&gt;spire-release keygen&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Ed25519 key pair; private key never on the server&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="off"><mxGeometry x="20" y="40" width="260" height="65" as="geometry"/></mxCell><mxCell id="sg" value='&lt;b&gt;spire-release sign&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;&amp;lt;deb&amp;gt;.manifest.json: version, package, arch, sha256, size, expiry, key_id&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="off"><mxGeometry x="20" y="135" width="260" height="80" as="geometry"/></mxCell><mxCell id="dist" value='&lt;b&gt;Server /dist&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;serves the .deb and manifest; computes and signs nothing&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="400" y="155" width="240" height="70" as="geometry"/></mxCell><mxCell id="dir" value='&lt;b&gt;Check-in update directive&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;target version + manifest URL&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="720" y="155" width="240" height="70" as="geometry"/></mxCell><mxCell id="ver" value='&lt;b&gt;Agent verifies, in order&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;1. signature under a pinned key, key_id known, not expired&lt;br&gt;2. package and architecture match&lt;br&gt;3. newer than the running version&lt;br&gt;4. downloaded bytes match signed sha256 + size&lt;br&gt;5. server&amp;#x27;s advertised hash agrees with the manifest&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="680" y="290" width="320" height="130" as="geometry"/></mxCell><mxCell id="refuse" value='&lt;b&gt;Update refused&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;reported to the server&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1060" y="320" width="110" height="70" as="geometry"/></mxCell><mxCell id="stage" value='&lt;b&gt;Stage a fallback&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;copy the previous package and the running spired binary, arm a rollback timer&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="680" y="470" width="320" height="60" as="geometry"/></mxCell><mxCell id="inst" value='&lt;b&gt;Install the new package&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;apt / dpkg&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="400" y="470" width="220" height="60" as="geometry"/></mxCell><mxCell id="ok" value="Healthy check-in&lt;br&gt;within 10 min?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="405" y="580" width="210" height="110" as="geometry"/></mxCell><mxCell id="done" value='&lt;b&gt;Health marker written&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;update complete&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="605" width="220" height="60" as="geometry"/></mxCell><mxCell id="rb" value='&lt;b&gt;Roll back&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;timer runs the OLD binary with --rollback-check, reinstalls the previous package, reports ROLLED_BACK; version not offered again for 24 h&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="680" y="590" width="320" height="90" as="geometry"/></mxCell><mxCell id="note" value="Signing is required by default (require_signed_updates). The first update of an agent installed by the bootstrap has no previous package, so it installs without rollback and says so." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="560" height="60" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="kg" target="sg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sg" target="dist"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dist" target="dir"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dir" target="ver"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="fails" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ver" target="refuse"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="all pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ver" target="stage"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="stage" target="inst"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="inst" target="ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ok" target="done"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ok" target="rb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="public key ships inside the agent package" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="kg" target="ver"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="340" y="92"/><mxPoint x="340" y="260"/><mxPoint x="840" y="260"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
