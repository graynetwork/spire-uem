<mxfile host="drawio"><diagram id="patch-campaigns" name="patch-campaigns"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" page="1" pageWidth="1180" pageHeight="720" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b&gt;Campaign lifecycle&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="300" height="24" as="geometry"/></mxCell><mxCell id="draft" value="&lt;b&gt;DRAFT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="110" height="50" as="geometry"/></mxCell><mxCell id="run" value='&lt;b&gt;RUNNING&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;dispatching the current stage&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="230" y="60" width="200" height="70" as="geometry"/></mxCell><mxCell id="pause" value='&lt;b&gt;PAUSED&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;admin paused&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="220" width="160" height="55" as="geometry"/></mxCell><mxCell id="halt" value='&lt;b&gt;HALTED&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;failure threshold exceeded, alert raised&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="560" y="220" width="220" height="70" as="geometry"/></mxCell><mxCell id="comp" value='&lt;b&gt;COMPLETED&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&g