0" y="320"/><mxPoint x="1080" y="320"/><mxPoint x="1080" y="167"/></Array></mxGeometry></mxCell><mxCell id="startnote" value="Started by an admin or the start_campaign workflow action, which never resumes a halted campaign." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="126" width="200" height="50" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;Stages&lt;/b&gt; (default plan; promotion runs under a per-campaign advisory lock)" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="365" width="800" height="24" as="geometry"/></mxCell><mxCell id="s1" value='&lt;b&gt;CANARY&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;devices in this ring&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="180" height="55" as="geometry"/></mxCell><mxCell id="s2" value='&lt;b&gt;PILOT&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;devices in this ring&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="440" y="410" width="180" height="55" as="geometry"/></mxCell><mxCell id="s3" value='&lt;b&gt;PRODUCTION&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;devices in this ring&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="840" y="410" width="180" height="55" as="geometry"/></mxCell><mxCell id="e10" value="all devices reported,&lt;br&gt;success ≥ threshold, soak done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="same gates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t3" value="&lt;b&gt;Per device, at each check-in&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="400" height="24" as="geometry"/></mxCell><mxCell id="g" value='&lt;b&gt;Gates&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;campaign running, not in a blackout window, ring matches the stage, maintenance window, deferral left&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="260" height="85" as="geometry"/></mxCell><mxCell id="disp" value='&lt;b&gt;Dispatch work&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;installed binary packages; CVE fixed versions are minimums&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="545" width="230" height="75" as="geometry"/></mxCell><mxCell id="apt" value='&lt;b&gt;apt-get install --only-upgrade&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;exact argv, no shell; user may defer via Spire Hub&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="650" y="545" width="230" height="75" as="geometry"/></mxCell><mxCell id="rep" value='&lt;b&gt;Report verified versions&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;before/after compared; below fixed version = failed&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="940" y="545" width="210" height="75" as="geometry"/></mxCell><mxCell id="e12" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="g" target="disp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="disp" target="apt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="apt" target="rep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="tally feeds stage gates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;" edge="1" parent="1" source="rep" target="s2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1045" y="495"/><mxPoint x="470" y="495"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
