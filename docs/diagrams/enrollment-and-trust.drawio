<mxfile host="drawio"><diagram id="enrollment-and-trust" name="enrollment-and-trust"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" page="1" pageWidth="1180" pageHeight="940" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="&lt;b&gt;Enrollment&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="300" height="24" as="geometry"/></mxCell><mxCell id="inst" value='&lt;b&gt;Install spire-agent&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;spired generates an enrollment key and a device key&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="260" height="60" as="geometry"/></mxCell><mxCell id="hastok" value="Enrollment&lt;br&gt;token?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="360" y="40" width="140" height="80" as="geometry"/></mxCell><mxCell id="man" value='&lt;b&gt;Stage PENDING_APPROVAL&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;an administrator approves&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="50" width="240" height="60" as="geometry"/></mxCell><mxCell id="reg" value='&lt;b&gt;POST /api/v1/enrollment/register&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;token, hardware UUID, enrollment key, CSR&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="170" width="200" height="70" as="geometry"/></mxCell><mxCell id="tokok" value="Token valid,&lt;br&gt;uses left, key&lt;br&gt;matches device?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="350" y="280" width="160" height="110" as="geometry"/></mxCell><mxCell id="ref" value='&lt;b&gt;Refused&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;uniform 401, rate-limited per IP, reason kept in token history&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="250" height="70" as="geometry"/></mxCell><mxCell id="appr" value="Needs approval,&lt;br&gt;or device was&lt;br&gt;revoked/rejected?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="560" y="280" width="170" height="110" as="geometry"/></mxCell><mxCell id="claim" value='&lt;b&gt;Claim bearer token + certificate&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;certificate SAN spire://device/&amp;lt;id&amp;gt;; tags and ring come from the token only&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="830" y="170" width="300" height="70" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;Every check-in&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="300" height="24" as="geometry"/></mxCell><mxCell id="ci" value='&lt;b&gt;Check-in over HTTPS / WSS&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;bearer token + client certificate&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="260" height="60" as="geometry"/></mxCell><mxCell id="mtls" value="Token and&lt;br&gt;certificate valid&lt;br&gt;for this device?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="360" y="465" width="170" height="100" as="geometry"/></mxCell><mxCell id="rej" value='&lt;b&gt;Request refused&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;required mode: no or bad certificate; any mode: mismatched certificate&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="360" y="610" width="200" height="70" as="geometry"/></mxCell><mxCell id="att" value='&lt;b&gt;TPM attestation&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;fresh AK-signed quote, EK certificate checked against vendor roots&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="600" y="480" width="230" height="60" as="geometry"/></mxCell><mxCell id="base" value='&lt;b&gt;Compare with approved PCR baselines&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;BASELINE_MATCH / BASELINE_MISMATCH / ATTESTED&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="880" y="480" width="260" height="60" as="geometry"/></mxCell><mxCell id="tr" value='&lt;b&gt;Trust decision&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;latest result within max age, or an unexpired exception&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="880" y="600" width="260" height="60" as="geometry"/></mxCell><mxCell id="gate" value="Trusted, or&lt;br&gt;enforcement&lt;br&gt;off / warn?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="920" y="715" width="180" height="110" as="geometry"/></mxCell><mxCell id="deliver" value='&lt;b&gt;Unseal network secrets&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Wi-Fi, 802.1X, EAP-TLS keys, WireGuard&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="600" y="735" width="230" height="70" as="geometry"/></mxCell><mxCell id="hold" value='&lt;b&gt;Withhold secrets&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;policy marked secrets_withheld; agent keeps any working profile&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="880" y="860" width="260" height="65" as="geometry"/></mxCell><mxCell id="renew" value='&lt;b&gt;Certificate renewal&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;agent renews at about 2/3 of its lifetime; revoking a device revokes its certificates&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="260" height="70" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="inst" target="hastok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="hastok" target="man"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="hastok" target="reg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="reg" target="tokok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tokok" target="ref"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tokok" target="appr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="appr" target="man"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="appr" target="claim"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="335"/></Array></mxGeometry></mxCell><mxCell id="e9" value="approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="man" target="claim"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="80"/></Array></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="claim" target="ci"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="420"/><mxPoint x="170" y="420"/></Array></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ci" target="mtls"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mtls" target="rej"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mtls" target="att"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="att" target="base"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="base" target="tr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tr" target="gate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gate" target="deliver"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gate" target="hold"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="ci" target="renew"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
